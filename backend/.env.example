# ====================================================================
# Personal AI Knowledge Assistant - Environment Configuration
# ====================================================================

# Database Connection (SQLite default, PostgreSQL supported)
DATABASE_URL=sqlite:///./data/app.db

# JWT Secret Key (IMPORTANT: Change this in production!)
# Generate a strong random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=super-secret-jwt-key-for-personal-knowledge-assistant-change-in-prod

# Google Gemini API Key (Required for RAG answers, Knowledge Graph, & Recommendations)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OCR Configuration (Optional - set if Tesseract is not in system PATH)
# Windows default: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux default: /usr/bin/tesseract
# Mac default: /opt/homebrew/bin/tesseract
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Maximum Upload File Size in Megabytes (default: 50MB)
MAX_UPLOAD_SIZE_MB=50
